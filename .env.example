# === Grafana Migration Tool — Environment Variables ===

# Source Grafana (откуда переносим)
SOURCE_GRAFANA_URL=https://source-grafana.local
SOURCE_GRAFANA_TOKEN=glsa_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx_xxxxxxxx

# Target Grafana (куда переносим)
TARGET_GRAFANA_URL=https://target-grafana.local
TARGET_GRAFANA_TOKEN=glsa_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx_xxxxxxxx

# Маппинг datasource UID (JSON): {"source_ds_uid": "target_ds_uid"}
# Можно оставить пустым, если datasource UID совпадают
DS_MAPPING={"old-prometheus-uid": "new-prometheus-uid", "old-loki-uid": "new-loki-uid"}

# Фильтр папок (JSON-массив). Пустое = все папки.
# FOLDERS=["Infrastructure", "Databases", "Monitoring"]
FOLDERS=

# Максимальное кол-во папок для переноса. 0 = без лимита.
MAX_FOLDERS=0

# Rate limit: кол-во дашбордов в батче перед паузой
BATCH_SIZE=5

# Пауза между батчами (секунды)
BATCH_DELAY=1.0

# Корневая папка в target, внутри которой создаётся вся структура.
# Пустое = папки создаются в корне target.
# TARGET_FOLDER=Migration-2026
TARGET_FOLDER=